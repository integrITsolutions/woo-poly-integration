{
    "name": "integritsol/woo-poly-integration",
    "description": "Integrates Polylang with WooCommerce. Modernized fork of hyyan/woo-poly-integration with HPOS, Cart/Checkout block, and Polylang 3.7+ support.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "IntegrIT Solutions",
            "email": "development@integritsol.de",
            "homepage": "https://integritsol.de",
            "role": "Maintainer of fork"
        },
        {
            "name": "Hyyan Abo Fakher",
            "email": "hyyanaf@gmail.com",
            "homepage": "https://github.com/hyyan",
            "role": "Original author"
        }
    ],
    "support": {
        "issues": "https://github.com/IntegrITSolutions/woo-poly-integration/issues",
        "source": "https://github.com/IntegrITSolutions/woo-poly-integration"
    },
    "keywords": [
        "wordpress",
        "wordpress-plugin",
        "polylang",
        "woocommerce",
        "multilingual",
        "hpos",
        "cart-checkout-blocks"
    ],
    "require": {
        "php": ">=7.4",
        "composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml.dist src/ __init__.php",
        "lint:fix": "phpcbf --standard=phpcs.xml.dist src/ __init__.php",
        "stan": "phpstan analyse --memory-limit=1G"
    }
}
