<?xml version="1.0"?>
<ruleset name="woo-poly-integration">
	<description>WordPress Coding Standards + PHPCompatibilityWP for woo-poly-integration.</description>

	<file>__init__.php</file>
	<file>src/</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/Views/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="parallel" value="4"/>
	<arg value="sp"/>

	<!-- Minimum supported versions -->
	<config name="minimum_supported_wp_version" value="6.6"/>
	<config name="testVersion" value="7.4-"/>

	<!-- Phase A baseline: WordPress core ruleset + PHP cross-version compat. -->
	<!-- We tighten in Phase B+ once the foundation is solid. -->
	<rule ref="WordPress-Core">
		<!-- These are noisy on a 5-year-old codebase mid-rewrite. Re-enable in Phase B/C. -->
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName"/>
		<exclude name="WordPress.NamingConventions.ValidFunctionName"/>
		<exclude name="WordPress.NamingConventions.ValidHookName"/>
		<exclude name="Generic.Files.LineLength"/>
		<exclude name="WordPress.WP.I18n.MissingTranslatorsComment"/>
		<exclude name="Squiz.Commenting"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customEscapingFunctions" type="array">
				<element value="esc_attr__"/>
				<element value="esc_html__"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="woo-poly-integration"/>
				<element value="woocommerce"/>
			</property>
		</properties>
	</rule>
</ruleset>
